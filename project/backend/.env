# =========================================================
# Market Making Trading Dashboard - Environment Variables
# =========================================================

# Database Configuration
# Option 1: Full database URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/MMA

# Option 2: Individual database components
DB_HOST=localhost
DB_PORT=5432
DB_NAME=MMA
DB_USER=postgres
DB_PASSWORD=password

# =========================================================
# API Configuration
# =========================================================

# Pinnacle API
PINNACLE_API_KEY=4a1fe69c82mshc5dca8e31d75ad3p18b29djsn46f8caf03b8c
PINNACLE_HOST=pinnacle-odds.p.rapidapi.com
PINNACLE_BASE_URL=https://pinnacle-odds.p.rapidapi.com

# Kalshi API
KALSHI_API_KEY=demo_kalshi_api_key_here
KALSHI_BASE_URL=https://trading-api.kalshi.com

# =========================================================
# Application Settings
# =========================================================

APP_NAME=Market Making Trading Dashboard API
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server Configuration
HOST=localhost
PORT=8111
WORKERS=1

# =========================================================
# Security Settings
# =========================================================

SECRET_KEY=demo-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# =========================================================
# Rate Limiting & Performance
# =========================================================

RATE_LIMIT_PER_MINUTE=60

# =========================================================
# Logging Configuration
# =========================================================

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =========================================================
# CORS Settings
# =========================================================

CORS_ORIGINS=["http://localhost:5173", "http://localhost:8111"]

# =========================================================
# Cache Configuration
# =========================================================

REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# =========================================================
# Trading Settings
# =========================================================

MAX_POSITION_SIZE=1000.0
MIN_QUOTE_SIZE=10.0
MAX_SPREAD_WIDTH=5.0
